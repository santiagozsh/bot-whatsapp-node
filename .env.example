# ── Application Configuration ────────────────────────────────
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
GOOGLE_SHEETS_ID=your-google-spreadsheet-id
SHEETS_VENTAS_NOMBRE=Ventas
GRUPO_AUTORIZADO=Contabilidad
TIEMPO_TTL_CONTEXTO=14400000
TIEMPO_CIERRE_RESPALDO=14400000
LOG_LEVEL=INFO

# ── Observability: Grafana Cloud Telemetry (Alloy) ───────────
ENVIRONMENT=development
METRICS_PORT=9090

# From Grafana Cloud Portal -> Prometheus -> Details:
GRAFANA_CLOUD_PROMETHEUS_URL=https://prometheus-prod-XX-prod-us-east-0.grafana.net/api/prom/push
GRAFANA_CLOUD_PROMETHEUS_USER=123456

# From Grafana Cloud Portal -> Loki -> Details:
GRAFANA_CLOUD_LOKI_URL=https://logs-prod-XX.grafana.net/loki/api/v1/push
GRAFANA_CLOUD_LOKI_USER=654321

# Grafana Cloud Access Policy Token (Metrics:Write + Logs:Write scopes):
GRAFANA_CLOUD_API_KEY=glc_eyJ...

